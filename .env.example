# ============================================================================
# Venture Harness — environment template
# Copy to .env.local and fill in per-venture values.
# Every venture gets its OWN domain, Vercel project, Neon database, and GA4
# property. Never copy production values between ventures.
# ============================================================================

# Public site URL (used for canonical URLs, sitemap, robots)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Layer 2: consented behavioural analytics (Google Analytics 4) ----------
# Leave empty until this venture has its own GA4 property.
# GA never loads before consent in strict mode. See config/analytics.yaml.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Vercel Web Analytics is intentionally not loaded: the current client has no
# proven immediate shutdown API for consent withdrawal.

# --- Layer 3: first-party commercial evidence (Neon Postgres) ---------------
# Venture-specific Neon connection string. When unset, the evidence API
# falls back to local JSONL under .data/ (development only).
DATABASE_URL=

# Set to "true" only in local development to allow the JSONL fallback.
EVIDENCE_LOCAL_FALLBACK=true
