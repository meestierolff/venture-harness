{
  "name": "venture-harness",
  "version": "0.2.0",
  "private": false,
  "description": "Open-source founder-alpha Launch Factory with bounded Codex CLI prototypes, locally tested Launch Contracts, fixture-tested app seeds and provider plans, and conservative Launch Receipts.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meestierolff/venture-harness.git"
  },
  "bugs": {
    "url": "https://github.com/meestierolff/venture-harness/issues"
  },
  "homepage": "https://github.com/meestierolff/venture-harness#readme",
  "keywords": [
    "ai-agents",
    "agentic-ai",
    "app-launcher",
    "saas-boilerplate",
    "startup",
    "nextjs",
    "vercel",
    "neon",
    "stripe",
    "mcp",
    "cli",
    "open-source"
  ],
  "bin": {
    "vh": "bin/vh.mjs"
  },
  "files": [
    "bin/vh-build-provenance.json",
    "bin/vh.mjs",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@9.15.9",
  "pnpm": {
    "overrides": {
      "brace-expansion@1.1.16": "1.1.18",
      "brace-expansion@5.0.7": "5.0.9",
      "js-yaml": "4.3.1",
      "nanoid": "3.3.18",
      "postcss": "8.5.23",
      "sharp": "0.35.0"
    }
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "workspace:build": "node scripts/workspace-build.mjs",
    "workspace:prepare": "node scripts/workspace-build.mjs --packages-only",
    "workspace:check": "node scripts/workspace-check.mjs",
    "workspace:pack": "node scripts/workspace-pack.mjs",
    "test:workspace": "vitest run --no-file-parallelism tests/workspace-boundaries.test.ts tests/command-surfaces-parity.test.ts tests/workspace-pack.test.ts tests/recursive-packed-credential.test.ts",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretypecheck": "pnpm workspace:prepare",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers=4 --testTimeout=30000 --exclude tests/workspace-boundaries.test.ts --exclude tests/command-surfaces-parity.test.ts --exclude tests/workspace-pack.test.ts --exclude tests/recursive-packed-credential.test.ts --exclude tests/migrations.test.ts --exclude tests/quality-migrations.test.ts --exclude tests/upgrade.test.ts --exclude tests/upgrade-operational.test.ts --exclude 'tests/credentials*.test.ts' --exclude 'tests/providers*.test.ts' --exclude 'tests/runtime-provider*.test.ts' --exclude tests/launch-router.test.ts --exclude tests/launch-fixtures.test.ts --exclude tests/cli-launch-integration.test.ts --exclude tests/mobile-scaffold.test.ts --exclude tests/analytics-packs.test.ts --exclude tests/analytics-taxonomy.test.ts",
    "test:workflow": "vitest run tests/workflow*.test.ts tests/cli*.test.ts",
    "test:providers": "vitest run tests/credentials*.test.ts tests/providers*.test.ts tests/runtime-provider*.test.ts",
    "test:migrations": "vitest run tests/migrations.test.ts tests/upgrade.test.ts tests/upgrade-operational.test.ts tests/quality-migrations.test.ts",
    "test:fixtures": "vitest run tests/launch-router.test.ts tests/launch-fixtures.test.ts tests/cli-launch-integration.test.ts tests/mobile-scaffold.test.ts",
    "test:data": "vitest run tests/data-sync.test.ts tests/data-provider-http-connectors.test.ts tests/default-data-learning-runtime.test.ts tests/analytics*.test.ts",
    "test:learning": "vitest run tests/operating-loop-runtime.test.ts tests/learning-loops.test.ts tests/learning-schedule.test.ts tests/learning-cadence-workflow.test.ts tests/cli-learning-integration.test.ts tests/default-data-learning-runtime.test.ts",
    "test:authorization": "vitest run tests/authorization.test.ts tests/checkpoint-evidence.test.ts tests/launch-authorization-scope.test.ts",
    "test:e2e": "node scripts/run-local-e2e.mjs",
    "test:watch": "vitest",
    "audit:test-controls": "node scripts/audit-test-controls.mjs",
    "agents:sync": "tsx scripts/sync-agent-skills.ts",
    "agents:check": "tsx scripts/check-agent-parity.ts",
    "lock:refresh": "tsx scripts/refresh-harness-lock.ts",
    "validate:skills": "tsx scripts/validate-skills.ts",
    "validate:docs": "tsx scripts/validate-docs.ts",
    "validate:links": "tsx scripts/validate-links.ts",
    "validate:claims": "tsx scripts/validate-claims.ts",
    "verify:seo": "tsx scripts/verify-seo.ts",
    "verify:raw-html": "tsx scripts/verify-raw-html.ts",
    "verify:raw-html:local": "node scripts/run-local-raw-html.mjs",
    "verify:consent": "tsx scripts/verify-consent.ts",
    "verify:analytics-events": "tsx scripts/verify-analytics-events.ts",
    "verify:analytics-pii": "tsx scripts/verify-analytics-pii.ts",
    "verify:experiment-assignment": "tsx scripts/verify-experiment-assignment.ts",
    "verify:pricing-recording": "tsx scripts/verify-pricing-recording.ts",
    "preverify": "pnpm workspace:prepare && pnpm seed:ensure",
    "verify": "tsx scripts/framework-health.ts --strict",
    "preverify:fast": "pnpm workspace:prepare && pnpm seed:ensure",
    "verify:fast": "tsx scripts/run-quality-profile.ts fast",
    "preverify:mvp": "pnpm workspace:prepare && pnpm seed:ensure",
    "verify:mvp": "tsx scripts/run-quality-profile.ts mvp",
    "preverify:release": "pnpm workspace:prepare && pnpm seed:ensure",
    "verify:release": "tsx scripts/run-quality-profile.ts release",
    "preverify:live": "pnpm workspace:prepare && pnpm seed:ensure",
    "verify:live": "tsx scripts/run-quality-profile.ts live",
    "preverify:stable": "pnpm workspace:prepare && pnpm seed:ensure",
    "verify:stable": "tsx scripts/run-quality-profile.ts stable",
    "health": "tsx scripts/framework-health.ts",
    "weekly": "tsx scripts/run-weekly-demand-analysis.ts",
    "outcome:add": "tsx scripts/append-outcome.ts",
    "experiment:add": "tsx scripts/append-experiment.ts",
    "improve:propose": "tsx scripts/propose-improvement.ts",
    "release:check": "tsx scripts/public-release-check.ts",
    "init:venture": "tsx scripts/init-venture.ts",
    "seed:fetch": "tsx scripts/seed-fetch.ts",
    "seed:ensure": "tsx scripts/seed-ensure.ts",
    "verify:seed-closure": "tsx scripts/verify-seed-closure.ts",
    "evidence:dogfood": "tsx scripts/export-dogfood-evidence.ts",
    "benchmark:standard-saas": "tsx scripts/run-standard-saas-token-benchmark.ts",
    "prevh": "pnpm workspace:prepare",
    "vh": "tsx scripts/vh.ts",
    "fixture:winner-loop": "tsx scripts/run-winner-loop-fixture.ts",
    "fixture:venture-launch": "tsx scripts/run-synthetic-venture-launch.mts"
  },
  "dependencies": {
    "@venture-harness/agent-runtime": "workspace:*",
    "@venture-harness/command-bus": "workspace:*",
    "@venture-harness/config": "workspace:*",
    "@venture-harness/core": "workspace:*",
    "@venture-harness/provider-registry": "workspace:*",
    "@venture-harness/provider-sdk": "workspace:*",
    "@neondatabase/serverless": "^0.10.4",
    "next": "15.5.21",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.18.0",
    "eslint-config-next": "15.5.21",
    "prettier": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
