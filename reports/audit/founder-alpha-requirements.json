  "statusVocabulary": ["VERIFIED", "FAILED", "EXTERNAL_BLOCKER", "NOT_RUN"],
  "commandContracts": {
    "final-agent-sync": { "command": "pnpm agents:sync", "cwd": "." },
    "final-e2e": { "command": "pnpm test:e2e", "cwd": "." },
    "final-fixture-d": { "command": "pnpm fixture:winner-loop", "cwd": "." },
    "final-frozen-install": { "command": "pnpm install --frozen-lockfile", "cwd": "." },
    "final-github-readback": {
      "command": "node scripts/verify-final-github-readback.mjs --output reports/audit/github-readback.json",
      "cwd": "."
    },
    "final-gitleaks-history": {
      "command": "gitleaks git . --config .gitleaks.toml --redact --no-banner --exit-code 1",
      "cwd": "."
    },
    "final-gitleaks-tree": {
      "command": "gitleaks dir . --config .gitleaks.toml --redact --no-banner --exit-code 1",
      "cwd": "."
    },
    "final-prod-audit": {
      "command": "pnpm audit --prod --audit-level=high",
      "cwd": "."
    },
    "final-raw-html": { "command": "pnpm verify:raw-html:local", "cwd": "." },
    "final-release-check": { "command": "pnpm release:check", "cwd": "." },
    "final-test-controls": { "command": "pnpm audit:test-controls", "cwd": "." },
    "final-verify": {
      "command": "pnpm verify -- --delegate \"pnpm test\" --delegate \"pnpm typecheck\"",
      "cwd": "."
    },
    "final-verify-fast": { "command": "pnpm verify:fast", "cwd": "." },
    "final-verify-live": {
      "command": "pnpm verify:live -- --report reports/audit/quality-live.json",
      "cwd": "."
    },
    "final-verify-release": {
      "command": "pnpm verify:release -- --report reports/audit/quality-release.json",
      "cwd": "."
    },
    "final-verify-mvp": { "command": "pnpm verify:mvp", "cwd": "." },
    "final-workspace-check": { "command": "pnpm workspace:check", "cwd": "." }
  },
