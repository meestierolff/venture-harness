      "require": "./dist/contracts.cjs"
    }
  },
  "dependencies": {
    "@venture-harness/audit": "workspace:*",
    "@venture-harness/billing": "workspace:*",
    "@venture-harness/command-bus": "workspace:*",
    "@venture-harness/config": "workspace:*",
    "@venture-harness/connections": "workspace:*",
    "@venture-harness/core": "workspace:*",
    "@venture-harness/entitlements": "workspace:*",
    "@venture-harness/events": "workspace:*",
    "@venture-harness/loops": "workspace:*",
    "@venture-harness/organizations": "workspace:*",
    "@venture-harness/policy": "workspace:*",
    "@venture-harness/telemetry": "workspace:*",
    "yaml": "^2.7.0"
  },
  "scripts": {
    "build": "node ../../scripts/workspace-build.mjs agent-runtime"
  }
