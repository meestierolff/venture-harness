{
  "name": "@venture-harness/cli-generator",
  "version": "0.2.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "bin": {
      "vh": "dist/bin.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "dependencies": {
    "@venture-harness/agent-runtime": "workspace:*",
    "@venture-harness/command-bus": "workspace:*",
    "@venture-harness/core": "workspace:*"
  },
  "scripts": {
    "build": "node ../../scripts/workspace-build.mjs cli-generator"
  }
}
